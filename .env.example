# Server
PORT=5001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=dx_app

# JWT
JWT_SECRET=change_me_to_a_strong_secret_key_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis (optional - queues/cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=false

# CORS / Frontend (password reset links)
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# File Upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Testing (copy to .env.test)
# DB_NAME=dx_app_test
# NODE_ENV=test
