# DEV environment — copy to .env.dev and fill in real values.
# Used by: npm run dev:dev | start:dev | migrate:dev | seed:dev | setup:dev
# Every value except the optional ones must be set (no localhost defaults).
# Variables already set in the process environment take precedence over this file.

APP_ENV=dev
NODE_ENV=production
PORT=7002

# Database
DB_HOST=72.62.70.70
DB_PORT=3306
DB_USER=dx_record
DB_PASSWORD=StrongPassword@123
DB_NAME=dx_app

# JWT (each at least 32 characters, unique per environment)
JWT_SECRET=environmentenvironmentenvironmentenvironment
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=environment1environmentenvironmentenvironmentenvironment
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis (optional - queues/cache)
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379

# Comma-separated browser origins allowed by CORS, e.g. https://dev-app.example.com
CORS_ORIGIN=https://app.dxrecord.com/admin/login
# Frontend base URL used in password reset links
APP_URL=https://app.dxrecord.com/admin/login

# File upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=5

# Company details on invoices. Set COMPANY_TRN (15 digits) to issue "Tax Invoice" PDFs.
# Use "\n" in COMPANY_ADDRESS / COMPANY_BANK_DETAILS for line breaks.
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_TRN=
COMPANY_BANK_DETAILS=
