# QA environment — copy to .env.qa and fill in real values.
# Used by: npm run dev:qa | start:qa | migrate:qa | seed:qa | setup:qa
# Every value except the optional ones must be set (no localhost defaults).
# Variables already set in the process environment take precedence over this file.

APP_ENV=qa
NODE_ENV=production
PORT=

# Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT (each at least 32 characters, unique per environment)
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis (optional - queues/cache)
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379

# Comma-separated browser origins allowed by CORS, e.g. https://qa-app.example.com
CORS_ORIGIN=
# Frontend base URL used in password reset links
APP_URL=

# File upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=5

# Company details on invoices. Set COMPANY_TRN (15 digits) to issue "Tax Invoice" PDFs.
# Use "\n" in COMPANY_ADDRESS / COMPANY_BANK_DETAILS for line breaks.
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_TRN=
COMPANY_BANK_DETAILS=
