{
  "name": "dx-server",
  "version": "1.0.0",
  "description": "Production-grade Node.js + Express + TypeScript + Knex + MySQL backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:check": "tsx scripts/check-db.ts",
    "db:status": "tsx scripts/db-status.ts",
    "setup": "npm run db:check && npm run migrate && npm run seed",
    "migrate": "tsx node_modules/knex/bin/cli.js migrate:latest",
    "migrate:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback",
    "seed": "tsx node_modules/knex/bin/cli.js seed:run",
    "seed:employees": "tsx scripts/seed-employees.ts",
    "seed:employees:force": "tsx scripts/seed-employees.ts -- --force",
    "db:finalize": "npm run migrate && npm run seed",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test jest --config jest.unit.config.js --runInBand",
    "test:integration": "NODE_ENV=test jest --config jest.integration.config.js --runInBand",
    "test:coverage": "NODE_ENV=test jest --config jest.unit.config.js --coverage --runInBand && NODE_ENV=test jest --config jest.integration.config.js --coverage --runInBand --coverageReporters=text-summary"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.5",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
