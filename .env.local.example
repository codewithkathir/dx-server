# LOCAL environment — copy to .env.local and fill in the secrets.
# Used by: npm run dev | start | migrate | seed | setup
# Unset host/URL values fall back to localhost defaults (see src/config/load-env.ts).

APP_ENV=local
NODE_ENV=development
PORT=5001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dx_local

# JWT (each at least 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis (optional - queues/cache)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated browser origins allowed by CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Frontend base URL used in password reset links
APP_URL=http://localhost:3000

# File upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Company details on invoices. Set COMPANY_TRN (15 digits) to issue "Tax Invoice" PDFs.
# Use "\n" in COMPANY_ADDRESS / COMPANY_BANK_DETAILS for line breaks.
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_TRN=
COMPANY_BANK_DETAILS=
